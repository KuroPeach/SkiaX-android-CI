<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Emuera.Headless</AssemblyName>
    <RootNamespace>MinorShift.Emuera</RootNamespace>
    <Version>1.824</Version>
    <InformationalVersion>1824+v24+EMv18+EEv56+Skiav16.6.4+headless</InformationalVersion>
    <LangVersion>12.0</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <NoWarn>CS8981;CS8632;CS0618;CS1998</NoWarn>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- 内核 + 共享控制台 + EWP + 无窗宿主（不含任何 WinForms/GDI 桌面文件） -->
  <ItemGroup>
    <Compile Include="..\Emuera\Runtime\**\*.cs" LinkBase="Runtime" />
    <Compile Include="..\Emuera\UI\Game\**\*.cs" LinkBase="UI\Game" />
    <Compile Include="..\Emuera\UI\Ewp\**\*.cs" LinkBase="UI\Ewp" />
    <Compile Include="..\Emuera\UI\Headless\**\*.cs" LinkBase="UI\Headless" />
    <Compile Include="..\Emuera\UI\IConsoleSurface.cs" LinkBase="UI" />
    <Compile Include="..\Emuera\UI\FontFactory.cs" LinkBase="UI" />
    <Compile Include="..\Emuera\UI\Dialog.cs" LinkBase="UI" />
    <Compile Include="..\Emuera\GlobalStatic.cs" LinkBase="." />
    <Compile Include="..\Emuera\Program.Shared.cs" LinkBase="." />
    <Compile Include="HeadlessProgram.cs" />
    <Compile Include="Stubs\**\*.cs" />
  </ItemGroup>

  <!-- 排除：Windows 音频 / 桌面诊断 / 死代码 / 桌面宿主专属 -->
  <ItemGroup>
    <Compile Remove="..\Emuera\Runtime\Utils\Sound.WMP.cs" />
    <Compile Remove="..\Emuera\Runtime\Utils\Sound.NAudio.cs" />
    <Compile Remove="..\Emuera\Runtime\Utils\NAudio_LoopStream.cs" />
    <Compile Remove="..\Emuera\Runtime\Utils\SoundTouch_byMarkHeath\**" />
    <Compile Remove="..\Emuera\Runtime\Utils\MemoryDiagnostic.cs" />
    <Compile Remove="..\Emuera\Runtime\Utils\EvilMask\Shape.cs" />
    <Compile Remove="..\Emuera\Runtime\Utils\EvilMask\Utils.Icon.cs" />

    <Compile Remove="..\Emuera\UI\Game\HotkeyState.cs" />
    <Compile Remove="..\Emuera\UI\Game\Rikaichan.cs" />
    <Compile Remove="..\Emuera\UI\Game\RikaichanAutogenerated.cs" />
    <Compile Remove="..\Emuera\UI\Game\AConsoleDisplayPart.cs" />
    <Compile Remove="..\Emuera\UI\Game\image\ImgUtils.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\Emuera\Properties\lang\emuera-eng.xml" Link="Properties\lang\emuera-eng.xml"
                      LogicalName="MinorShift.Emuera.Properties.lang.emuera-eng.xml" />
    <EmbeddedResource Include="..\Emuera\Properties\lang\emuera-zhs.xml" Link="Properties\lang\emuera-zhs.xml"
                      LogicalName="MinorShift.Emuera.Properties.lang.emuera-zhs.xml" />
    <EmbeddedResource Include="..\Emuera\Properties\fonts\BIZUDGothic-Regular.ttf" Link="Properties\fonts\BIZUDGothic-Regular.ttf"
                      LogicalName="MinorShift.Emuera.Properties.fonts.BIZUDGothic-Regular.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Enums.NET" Version="5.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>

</Project>
