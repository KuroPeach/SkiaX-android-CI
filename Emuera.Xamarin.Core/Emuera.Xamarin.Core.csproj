<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net8.0-windows</TargetFrameworks>
    <OutputType>Library</OutputType>
    <RootNamespace>XEmuera</RootNamespace>
    <AssemblyName>XEmuera.Core</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS0436;CS8981;CS0037;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS0266;CS1503;CS0029;CS1929;CS0176;CS0120;CS0019;CS0030;CS1501;CS0117;CS1061;CS0246;CS0121;CS0119;CS0103;CS7036;CS0200;CS0021;CS1729;CS0122;CS1977</NoWarn>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!-- net8.0-windows 目标：启用 WINDOWS 条件编译 + System.Drawing 隐式转换 -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="XEmuera.Desktop" />
    <InternalsVisibleTo Include="XEmuera.Android" />
  </ItemGroup>

  <!-- 全局 using：System.Drawing → XEmuera.Drawing 类型别名 -->
  <ItemGroup>
    <Using Include="XEmuera.Drawing.Color" Alias="Color" />
    <Using Include="XEmuera.Drawing.Rectangle" Alias="Rectangle" />
    <Using Include="XEmuera.Drawing.Point" Alias="Point" />
    <Using Include="XEmuera.Drawing.Size" Alias="Size" />
    <Using Include="XEmuera.Drawing.FontStyle" Alias="FontStyle" />
    <Using Include="XEmuera.Drawing.Brush" Alias="Brush" />
    <Using Include="XEmuera.Drawing.Pen" Alias="Pen" />
    <Using Include="XEmuera.Drawing.GraphicsUnit" Alias="GraphicsUnit" />
    <Using Include="XEmuera.Drawing.SolidBrush" Alias="SolidBrush" />
    <Using Include="XEmuera.Drawing.Font" Alias="Font" />
    <Using Include="MinorShift.Emuera.SkiaFontFamily" Alias="FontFamily" />
    <Using Include="MinorShift.Emuera.SkiaInstalledFontCollection" Alias="InstalledFontCollection" />
  </ItemGroup>

  <!-- 全局 using：命名空间转发 -->
  <ItemGroup>
    <Using Include="MinorShift.Emuera.GameView" />
    <Using Include="MinorShift.Emuera.Content" />
    <Using Include="MinorShift.Emuera.Runtime.Utils" />
    <Using Include="MinorShift.Emuera.Runtime.Script" />
    <Using Include="MinorShift.Emuera.Runtime.Script.Statements" />
    <Using Include="MinorShift.Emuera.Runtime.Script.Statements.Expression" />
    <Using Include="MinorShift.Emuera.Runtime.Script.Statements.Function" />
    <Using Include="MinorShift.Emuera.Runtime.Script.Statements.Variable" />
    <Using Include="MinorShift.Emuera.Runtime.Script.Data" />
    <Using Include="MinorShift.Emuera.Runtime.Script.Parser" />
    <Using Include="MinorShift.Emuera.GameProc" />
    <Using Include="MinorShift.Emuera.GameData.Variable" />
    <Using Include="MinorShift.Emuera.GameData.Function" />
    <Using Include="MinorShift.Emuera.UI" />
    <Using Include="MinorShift.Emuera.UI.Game" />
    <Using Include="MinorShift.Emuera.UI.Game.Image" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Optimize>False</Optimize>
  </PropertyGroup>

  <!-- 内核：直接编译 LazyLoading 的 Runtime/ 目录 -->
  <ItemGroup>
    <Compile Include="..\Emuera\Runtime\**\*.cs" LinkBase="Runtime" />
  </ItemGroup>

  <!-- 内核 Runtime/ 排除项 -->
  <ItemGroup>
    <Compile Remove="..\Emuera\Runtime\Utils\Sound.WMP.cs" />
    <Compile Remove="..\Emuera\Runtime\Utils\WinmmTimer.cs" />
    <Compile Remove="..\Emuera\Runtime\Utils\PluginSystem\**" />
    <Compile Remove="..\Emuera\Runtime\Utils\EvilMask\Shape.cs" />
    <Compile Remove="..\Emuera\Runtime\Script\Statements\Clipboard.cs" />
    <Compile Remove="..\Emuera\Runtime\Utils\EvilMask\Utils.cs" />
    <Compile Remove="..\Emuera\Runtime\Utils\EvilMask\ConsoleDivPart.cs" />
    <!-- NAudio: Windows-only audio -->
    <Compile Remove="..\Emuera\Runtime\Utils\Sound.NAudio.cs" />
    <Compile Remove="..\Emuera\Runtime\Utils\NAudio_LoopStream.cs" />
    <Compile Remove="..\Emuera\Runtime\Utils\SoundTouch_byMarkHeath\**" />
  </ItemGroup>

  <!-- LazyLoading 主项目入口（平台特定） -->
  <ItemGroup>
    <Compile Remove="..\Emuera\Program.cs" />
    <Compile Remove="..\Emuera\GlobalStatic.cs" />
  </ItemGroup>

  <!-- Core 项目自带 stub 文件 -->
  <ItemGroup>
    <Compile Include="Stubs\**\*.cs" />
  </ItemGroup>

  <!-- 平台层：共享代码 -->
  <ItemGroup>
    <Compile Include="..\Emuera.Xamarin\Platform\**\*.cs" Exclude="..\Emuera.Xamarin\Platform\Forms\**" />
    <Compile Include="..\Emuera.Xamarin\Drawing\**\*.cs" />
    <Compile Include="..\Emuera.Xamarin\Models\**\*.cs" />
    <Compile Include="..\Emuera.Xamarin\Forms\**\*.cs" />
    <Compile Include="..\Emuera.Xamarin\Utils.cs" />
    <Compile Include="..\Emuera\UI\Game\Rikaichan.cs" LinkBase="Runtime\UI\Game" />
    <Compile Include="..\Emuera\UI\Game\RikaichanAutogenerated.cs" LinkBase="Runtime\UI\Game" />
  </ItemGroup>

  <!-- 平台层排除项 -->
  <ItemGroup>
    <!-- WinForms stub -->
    <Compile Remove="..\Emuera.Xamarin\Platform\Stubs\WinForms.cs" />
    <!-- NAudio stub -->
    <Compile Remove="..\Emuera.Xamarin\Platform\Stubs\SoundAndBgm.cs" />
    <!-- Lang.cs 与 LazyLoading 内核冲突 -->
    <Compile Remove="..\Emuera.Xamarin\Platform\Lang.cs" />
    <!-- ConfigCode.cs 与 LazyLoading 内核冲突 -->
    <Compile Remove="..\Emuera.Xamarin\Platform\Config\ConfigCode.cs" />
    <!-- Desktop-only: DesktopHost, DesktopConfigDialog, DesktopDebugDialog -->
    <Compile Remove="..\Emuera.Xamarin\DesktopHost.cs" />
    <Compile Remove="..\Emuera.Xamarin\DesktopConfigDialog.cs" />
    <Compile Remove="..\Emuera.Xamarin\DesktopDebugDialog.cs" />
    <!-- VersionUpdate: XEmuera-specific -->
    <Compile Remove="..\Emuera.Xamarin\VersionUpdate.cs" />
    <!-- LanguageModel: depends on excluded Lang.cs -->
    <Compile Remove="..\Emuera.Xamarin\Models\LanguageModel.cs" />
    <!-- XAML pages: need XAML code generation -->
    <Compile Remove="..\Emuera.Xamarin\Views\ConfigValuePopup.xaml.cs" />
    <Compile Remove="..\Emuera.Xamarin\Views\TxtFilePage.xaml.cs" />
    <Compile Remove="..\Emuera.Xamarin\Views\SettingsPage.xaml.cs" />
    <Compile Remove="..\Emuera.Xamarin\Views\MainMenuPage.xaml.cs" />
    <Compile Remove="..\Emuera.Xamarin\Views\LanguagePage.xaml.cs" />
    <Compile Remove="..\Emuera.Xamarin\Views\GameItemPage.xaml.cs" />
    <Compile Remove="..\Emuera.Xamarin\Views\FontSettingsPage.xaml.cs" />
    <Compile Remove="..\Emuera.Xamarin\Views\ConfigSettingsPage.xaml.cs" />
    <Compile Remove="..\Emuera.Xamarin\Views\ConfigPage.xaml.cs" />
    <Compile Remove="..\Emuera.Xamarin\Views\AboutPage.xaml.cs" />
    <Compile Remove="..\Emuera.Xamarin\App.xaml.cs" />
    <Compile Remove="..\Emuera.Xamarin\MainPage.xaml.cs" />
    <!-- Rikaichan: references System.Windows.Forms -->
    <Compile Remove="..\Emuera\UI\Game\Rikaichan.cs" />
    <Compile Remove="..\Emuera\UI\Game\RikaichanAutogenerated.cs" />
  </ItemGroup>

  <!-- 资源文件 -->
  <ItemGroup>
    <EmbeddedResource Include="..\Emuera.Xamarin\Resources\Docs\Emuera_readme.txt" LinkBase="Resources\Docs" />
    <EmbeddedResource Include="..\Emuera.Xamarin\Resources\Fonts\MS Gothic.ttf" LinkBase="Resources\Fonts" />
    <EmbeddedResource Include="..\Emuera.Xamarin\Resources\Fonts\Microsoft YaHei.ttf" LinkBase="Resources\Fonts" />
    <EmbeddedResource Include="..\Emuera.Xamarin\Resources\Images\app_icon.png" LinkBase="Resources\Images" />
    <EmbeddedResource Include="..\Emuera.Xamarin\Resources\ConfigsText.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>ConfigsText.Designer.cs</LastGenOutput>
      <LogicalName>XEmuera.Resources.ConfigsText.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Emuera.Xamarin\Resources\ConfigsText.ja-JP.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>ConfigsText.ja-JP.Designer.cs</LastGenOutput>
      <LogicalName>XEmuera.Resources.ConfigsText.ja-JP.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Emuera.Xamarin\Resources\StringsText.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>StringsText.Designer.cs</LastGenOutput>
      <LogicalName>XEmuera.Resources.StringsText.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Emuera.Xamarin\Resources\StringsText.ja-JP.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>StringsText.ja-JP.Designer.cs</LastGenOutput>
      <LogicalName>XEmuera.Resources.StringsText.ja-JP.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- NuGet 包引用（跨平台，不含 WinForms/WPF 依赖） -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.Svg" Version="1.60.0" />
    <PackageReference Include="Xamarin.Forms" Version="5.0.0.2478">
      <ExcludeAssets>build;buildTransitive</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Xamarin.Essentials" Version="1.7.3" />
  </ItemGroup>

  <!-- net8.0-windows 目标：SkiaSharp Desktop 扩展（提供 ToBitmap 等） -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="SkiaSharp.Views.Desktop.Common" Version="2.88.8" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Emuera.Xamarin\Resources\ConfigsText.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ConfigsText.resx</DependentUpon>
    </Compile>
    <Compile Include="..\Emuera.Xamarin\Resources\StringsText.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>StringsText.resx</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
