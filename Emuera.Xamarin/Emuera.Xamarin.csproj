<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <DefineConstants>$(DefineConstants);DESKTOP_APP</DefineConstants>
    <RootNamespace>XEmuera</RootNamespace>
    <AssemblyName>XEmuera</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS0436;CS8981;CS0037;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS0266;CS1503;CS0029;CS1929;CS0176;CS0120;CS0019;CS0030;CS1501;CS0117;CS1061;CS0246;CS0121;CS0119;CS0103;CS7036;CS0200;CS0021;CS1729;CS0122;CS1977</NoWarn>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!-- 全局 using：System.Drawing → XEmuera.Drawing 类型别名 -->
  <ItemGroup>
    <Using Include="XEmuera.Drawing.Color" Alias="Color" />
    <Using Include="XEmuera.Drawing.Rectangle" Alias="Rectangle" />
    <Using Include="XEmuera.Drawing.Point" Alias="Point" />
    <Using Include="XEmuera.Drawing.Size" Alias="Size" />
    <Using Include="XEmuera.Drawing.FontStyle" Alias="FontStyle" />
    <Using Include="XEmuera.Drawing.Brush" Alias="Brush" />
    <Using Include="XEmuera.Drawing.Pen" Alias="Pen" />
    <Using Include="XEmuera.Drawing.GraphicsUnit" Alias="GraphicsUnit" />
    <Using Include="XEmuera.Drawing.SolidBrush" Alias="SolidBrush" />
    <Using Include="XEmuera.Drawing.Font" Alias="Font" />
    <Using Include="MinorShift.Emuera.SkiaFontFamily" Alias="FontFamily" />
    <Using Include="MinorShift.Emuera.SkiaInstalledFontCollection" Alias="InstalledFontCollection" />
  </ItemGroup>

  <!-- 全局 using：命名空间转发（内核期望的命名空间 → Platform 实际命名空间） -->
  <ItemGroup>
    <Using Include="MinorShift.Emuera.GameView" />
    <Using Include="MinorShift.Emuera.Content" />
    <Using Include="MinorShift.Emuera.Runtime.Utils" />
    <Using Include="MinorShift.Emuera.Runtime.Script" />
    <Using Include="MinorShift.Emuera.Runtime.Script.Statements" />
    <Using Include="MinorShift.Emuera.Runtime.Script.Statements.Expression" />
    <Using Include="MinorShift.Emuera.Runtime.Script.Statements.Function" />
    <Using Include="MinorShift.Emuera.Runtime.Script.Statements.Variable" />
    <Using Include="MinorShift.Emuera.Runtime.Script.Data" />
    <Using Include="MinorShift.Emuera.Runtime.Script.Parser" />
    <Using Include="MinorShift.Emuera.GameProc" />
    <Using Include="MinorShift.Emuera.GameData.Variable" />
    <Using Include="MinorShift.Emuera.GameData.Function" />
    <Using Include="MinorShift.Emuera.UI" />
    <Using Include="MinorShift.Emuera.UI.Game" />
    <Using Include="MinorShift.Emuera.UI.Game.Image" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Optimize>False</Optimize>
  </PropertyGroup>

  <!-- ============================================================ -->
  <!-- 内核：直接编译 LazyLoading 的 Runtime/ 目录                     -->
  <!-- UI 层由 Platform/ 目录的 XEmuera-1 Skia 版本提供               -->
  <!-- ============================================================ -->
  <ItemGroup>
    <Compile Include="..\Emuera\Runtime\**\*.cs" LinkBase="Runtime" />
  </ItemGroup>

  <!-- 内核 Runtime/ 排除项（仅排除 WinForms/Desktop 专用文件） -->
  <ItemGroup>
    <!-- WinForms/Desktop 音频：NAudio 不可用于 Android -->
    <Compile Remove="..\Emuera\Runtime\Utils\Sound.WMP.cs" />
    <Compile Remove="..\Emuera\Runtime\Utils\Sound.NAudio.cs" />
    <!-- WinForms 插件系统 -->
    <Compile Remove="..\Emuera\Runtime\Utils\PluginSystem\**" />
    <!-- System.Drawing.Graphics / Drawing2D -->
    <Compile Remove="..\Emuera\Runtime\Utils\EvilMask\Shape.cs" />
    <!-- System.Windows.Forms -->
    <Compile Remove="..\Emuera\Runtime\Script\Statements\Clipboard.cs" />
    <!-- System.Drawing.Bitmap/Icon -->
    <Compile Remove="..\Emuera\Runtime\Utils\EvilMask\Utils.cs" />
    <!-- 内核 PlatformInterop：Xamarin 有自己的 stub 版本 -->
    <Compile Remove="..\Emuera\Runtime\Utils\PlatformInterop.cs" />
    <!-- ConsoleDivPart 依赖 Shape.cs -->
    <Compile Remove="..\Emuera\Runtime\Utils\EvilMask\ConsoleDivPart.cs" />
    <!-- Creator.Method.cs 不再引用 PluginSystem，恢复编译 -->
    <!-- <Compile Remove="..\Emuera\Runtime\Script\Statements\Function\Creator.Method.cs" /> -->
    <!-- Android 专用：Windows TFM 下排除 -->
    <!-- NAudio 依赖：Android 不可用 -->
    <Compile Remove="..\Emuera\Runtime\Utils\NAudio_LoopStream.cs" />
    <Compile Remove="..\Emuera\Runtime\Utils\SoundTouch_byMarkHeath\**" />
  </ItemGroup>

  <!-- LazyLoading 主项目入口（WinForms 专用） -->
  <ItemGroup>
    <Compile Remove="..\Emuera\Program.cs" />
    <Compile Remove="..\Emuera\GlobalStatic.cs" />
  </ItemGroup>

  <!-- ============================================================ -->
  <!-- 平台层：从 XEmuera-1 复制的 Skia/Xamarin 文件                  -->
  <!-- ============================================================ -->
  <ItemGroup>
    <Compile Include="Platform\**\*.cs" />
    <Compile Include="Drawing\**\*.cs" />
    <Compile Include="Models\**\*.cs" />
    <Compile Include="Views\**\*.cs" />
    <Compile Include="Forms\**\*.cs" />
    <Compile Include="Resources\**\*.cs" />
    <Compile Include="Utils.cs" />
    <Compile Include="VersionUpdate.cs" />
    <Compile Include="App.xaml.cs" />
    <Compile Include="MainPage.xaml.cs" />
    <Compile Include="DesktopHost.cs" />
    <Compile Include="DesktopConfigDialog.cs" />
    <Compile Include="DesktopDebugDialog.cs" />
    <Compile Include="..\Emuera\UI\Game\Rikaichan.cs" LinkBase="Runtime\UI\Game" />
    <Compile Include="..\Emuera\UI\Game\RikaichanAutogenerated.cs" LinkBase="Runtime\UI\Game" />
    <Compile Include="..\Emuera\UI\Framework\Forms\RikaiDialog.cs" LinkBase="Runtime\UI\Framework\Forms" />
    <Compile Include="..\Emuera\UI\Framework\Forms\RikaiDialog.Designer.cs" LinkBase="Runtime\UI\Framework\Forms" />
  </ItemGroup>

  <!-- Platform 层排除项 -->
  <ItemGroup>
    <!-- Android 专用：Windows TFM 下排除 -->
    <Compile Remove="Platform\Audio\**" />
    <!-- WinForms 专用 -->
    <Compile Remove="Platform\Forms\**" />
    <!-- WinForms stub 与真正的 System.Windows.Forms 冲突 -->
    <Compile Remove="Platform\Stubs\WinForms.cs" />
    <Compile Remove="Platform\Stubs\SoundAndBgm.cs" />
    <!-- Lang.cs 与 LazyLoading 内核的 Lang.cs 冲突 -->
    <Compile Remove="Platform\Lang.cs" />
    <!-- ConfigCode.cs 与 LazyLoading 内核的 ConfigCode.cs 冲突（枚举重复定义） -->
    <Compile Remove="Platform\Config\ConfigCode.cs" />
    <!-- XAML 页面：Xamarin.Forms XAML 代码生成在 net8.0-windows TFM 下不工作 -->
    <Compile Remove="Views\SettingsPage.xaml.cs" />
    <Compile Remove="Views\MainMenuPage.xaml.cs" />
    <Compile Remove="Views\LanguagePage.xaml.cs" />
    <Compile Remove="Views\GameItemPage.xaml.cs" />
    <Compile Remove="Views\FontSettingsPage.xaml.cs" />
    <Compile Remove="Views\ConfigSettingsPage.xaml.cs" />
    <Compile Remove="Views\ConfigPage.xaml.cs" />
    <Compile Remove="Views\AboutPage.xaml.cs" />
    <Compile Remove="Views\TxtFilePage.xaml.cs" />
    <Compile Remove="Views\ConfigValuePopup.xaml.cs" />
    <!-- XAML 入口页：同样需要 XAML 代码生成 -->
    <Compile Remove="MainPage.xaml.cs" />
    <Compile Remove="App.xaml.cs" />
    <!-- VersionUpdate.cs 引用 XEmuera 特有 ConfigCode -->
    <Compile Remove="VersionUpdate.cs" />
    <!-- LanguageModel.cs 引用 Lang.LoadLanguageFile（Platform Lang.cs 被排除） -->
    <Compile Remove="Models\LanguageModel.cs" />
  </ItemGroup>

  <!-- ============================================================ -->
  <!-- 资源文件                                                       -->
  <!-- ============================================================ -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\Docs\Emuera_readme.txt" />
    <EmbeddedResource Include="Resources\Fonts\MS Gothic.ttf" />
    <EmbeddedResource Include="Resources\Fonts\Microsoft YaHei.ttf" />
    <EmbeddedResource Include="Resources\Fonts\SimHei.ttf" />
    <EmbeddedResource Include="Resources\Images\app_icon.png" />
    <EmbeddedResource Include="Resources\Images\chevron_right.svg" />
    <EmbeddedResource Include="Resources\Images\edit.svg" />
    <EmbeddedResource Include="Resources\Images\gallery_view.svg" />
    <EmbeddedResource Include="Resources\Images\gamepad.svg" />
    <EmbeddedResource Include="Resources\Images\lock_rotation.svg" />
    <EmbeddedResource Include="Resources\Images\lock_rotation_open.svg" />
    <EmbeddedResource Include="Resources\Images\menu_show.svg" />
    <EmbeddedResource Include="Resources\Images\publish.svg" />
    <EmbeddedResource Include="Resources\Images\scroll_vertical.svg" />
    <!-- RESX 资源文件 -->
    <EmbeddedResource Include="Resources\ConfigsText.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>ConfigsText.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\ConfigsText.ja-JP.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>ConfigsText.ja-JP.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\StringsText.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>StringsText.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\StringsText.ja-JP.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>StringsText.ja-JP.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <!-- XAML 资源 -->
  <ItemGroup>
    <EmbeddedResource Update="App.xaml">
      <Generator>MSBuild:Compile</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="MainPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Views\ConfigPage.xaml">
      <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Views\ConfigSettingsPage.xaml">
      <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Views\FontSettingsPage.xaml">
      <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Views\LanguagePage.xaml">
      <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Views\MainMenuPage.xaml">
      <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Views\TxtFilePage.xaml">
      <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
    </EmbeddedResource>
  </ItemGroup>

  <!-- ============================================================ -->
  <!-- NuGet 包引用                                                   -->
  <!-- ============================================================ -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <PackageReference Include="ReorderableCollectionView.Forms" Version="1.0.0" />
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.Svg" Version="1.60.0" />
    <PackageReference Include="SkiaSharp.Views.WPF" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.Views.Forms" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.Views.Forms.WPF" Version="2.88.8" />
    <PackageReference Include="Spillman.Xamarin.Forms.ColorPicker" Version="1.0.8" />
    <PackageReference Include="Xamarin.CommunityToolkit" Version="2.0.2" />
    <PackageReference Include="Xamarin.Forms" Version="5.0.0.2478" />
    <PackageReference Include="Xamarin.Essentials" Version="1.7.3" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Resources\ConfigsText.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ConfigsText.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\StringsText.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>StringsText.resx</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
